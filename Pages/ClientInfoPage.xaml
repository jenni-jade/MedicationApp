<Page x:Class="MedicationApp.Pages.ClientInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicationApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientInfoPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" VerticalAlignment="Stretch">

            <Rectangle Name="rect" Width="100"  VerticalAlignment="Stretch" Fill="#99000000"  >
            </Rectangle>
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Name="LoggedUser" Height="30" Margin="0, 58, 0, 0" Foreground="White"></TextBlock>

            <Button Click="Home_Click" Height="50" VerticalAlignment="Top" Margin="0,88,0,0">Home</Button>
            <Button Click="Mar_Click" Height="50" VerticalAlignment="Top" Margin="0,288,0,0" RenderTransformOrigin="0.615,-3.49">Mar</Button>
            <Button Click="Caregiver_Click" Height="50" VerticalAlignment="Top" Margin="0,188,0,0">Caregiver Info</Button>
            <Button Click="Client_Click" Height="50" VerticalAlignment="Top" Margin="0,138,0,0">Patient Info</Button>
            <Button Height="50" VerticalAlignment="Top" Margin="0,238,0,0">Schedule</Button>
            <Button Height="50" VerticalAlignment="Top" Margin="0,338,0,0">Report</Button>
            <Button Click="To_login" Height="50" VerticalAlignment="Top" Margin="0,388,0,0">Logout</Button>

        </Grid>
        <Grid Grid.Column="1" Margin="10, 0, 10, 0" HorizontalAlignment="Center">
            <TextBlock Text="Patient Info" FontSize="36"  Margin="10, 25, 10, 0" />
        </Grid>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="First/Last Name" Margin="23,100,577,273" HorizontalAlignment="Center"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="Date of Birth" Margin="350,100,250,275" HorizontalAlignment="Center"/>
        <TextBox Name="Name" VerticalAlignment="Top" Grid.Column="1" Width="150" Height="25" Margin="-300, 100, 0, 0"></TextBox>
        <TextBox Name="DOB" VerticalAlignment="Top" Grid.Column="1" Width="150" Height="25" Margin="350, 100, 0, 0"></TextBox>
        <Button Grid.Column="1" Name="Search" Click="Search_Click" Width="150" Height="30" VerticalAlignment="Top" Margin="-200, 150, 0,0">Search</Button>
        <Button Grid.Column="1" Name="AddPatient" Click="View_Click" Width="150" Height="30" VerticalAlignment="Top" Margin="200, 150, 0, 0">Add New Patient</Button>
        <Grid Grid.Column="1" Margin="150, 0, 150, 0" HorizontalAlignment="Center" >
            <DataGrid  AutoGenerateColumns="False" x:Name="PatientChart" IsReadOnly="False" Margin="-315,200,-299,63" ScrollViewer.CanContentScroll="True" 
		ScrollViewer.VerticalScrollBarVisibility="Auto"
		ScrollViewer.HorizontalScrollBarVisibility="Auto" CanUserAddRows="false">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient ID" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding name}"/>
                    <DataGridTextColumn Header="Date of Birth" Binding="{Binding birth}"/>
                    <DataGridTextColumn Header="Height" Binding="{Binding height}"/>
                    
                    
                    <DataGridTemplateColumn Header="View Patient">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="View" Click="View_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Edit Patient">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Edit" Click="Edit_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Delete Patient">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Click="Remove_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                
            </DataGrid>
        </Grid>

    </Grid>
</Page>
