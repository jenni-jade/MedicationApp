<Page x:Class="MedicationApp.Pages.AddPatient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicationApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddPatient">

    <Grid>
        <TextBlock Text="Add Patient" FontSize="30" Margin="0,15,0,100" HorizontalAlignment="Center" />
        <TextBlock Text="First/Last Name"  Margin="-475, 75, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Name" Width="150" Height="20" Margin="-200, 80,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Date of Birth"  Margin="-475, 110, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="DOB" Width="150" Height="20" Margin="-200, 110,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Gender"  Margin="-475, 145, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Gender" Width="150" Height="20" Margin="-200, 145,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="SSN"  Margin="-475, 180, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="SSN" Width="150" Height="20" Margin="-200, 180,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Address"  Margin="-475, 215, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Address" Width="150" Height="20" Margin="-200, 215,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Height"  Margin="-475, 250, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Height" Width="150" Height="20" Margin="-200, 250,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Emergency Contact"  Margin="150, 215, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="EmergencyContact" Width="150" Height="20" Margin="425, 215,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Contact Number"  Margin="150, 250, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="ContactNumber" Width="150" Height="20" Margin="425, 250, 0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Referring Physician"  Margin="150, 75, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Physician" Width="150" Height="20" Margin="425, 80,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Diagnosis"  Margin="150, 110, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Diagnosis" Width="150" Height="20" Margin="425, 110 ,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Medication"  Margin="150, 145, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="Medication" Width="150" Height="20" Margin="425, 145 ,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Email Address"  Margin="150, 180, 0, 0" HorizontalAlignment="Center"/>
        <TextBox Name="EmailAddress" Width="150" Height="20" Margin="425, 180 ,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <Button Name="Save" Click="Save_Click" Width="150" Height="25" VerticalAlignment="Bottom" Margin="-200,0,0,39">Save Patient</Button>
        <Button Name="Discard" Click="Discard_Click" Width="150" Height="25" VerticalAlignment="Bottom" Margin="300,0,0,39">Discard</Button>

    </Grid>
</Page>
