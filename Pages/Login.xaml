<Page x:Class="MedicationApp.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicationApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid>

            <Rectangle Grid.Column="0" VerticalAlignment="Stretch" Fill="#000137"/>
            <TextBlock Grid.Column="0" Foreground="White" Text="Sign In" FontSize="36" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, -435, 0, 0"/>
            <TextBlock  Grid.Column="0" Foreground="White" Text="UserName" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-210, -245, 10, 10" FontSize="16"/>
            <TextBox Grid.Column="0" Name="userText" Foreground="Black" Height="30" Background="White" HorizontalAlignment="Center" Text="" Margin="125, -250, 0, 0" Width="250"/>
            <TextBlock Grid.Column="0" Foreground="White" Text="Password" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-210, -115, 10, 10" FontSize="16"/>
            <TextBox Grid.Column="0" Name="passwordText"  Foreground="Black" Height="30" Background="White" HorizontalAlignment="Center" Text="" Margin="125, -125, 0, 0" Width="250" />
            <Button  Grid.Column="0" HorizontalAlignment="Center" Width="125" Height="40" Margin="0, 45, 0, 0"
                    Click="SignIn_Click" Command="{Binding SignInCommand}" CommandParameter="HomePage" FontStretch="Normal" RenderTransformOrigin="0.555,1.74" Content="Sign in">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="100"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>
