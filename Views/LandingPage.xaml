<Page x:Class="MedicationApp.Pages.LandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicationApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LandingPage">

    <!-- Define Resources -->
    <Page.Resources>
        <!-- Modern Sidebar Button Style with Raleway Thin Font -->
        <Style x:Key="ModernMenuButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Raleway Thin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2F33"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7289DA"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7289DA" BlurRadius="15" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Click Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4E5D94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,-75">
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F2027" Offset="0" />
                <GradientStop Color="#203A43" Offset="0.5" />
                <GradientStop Color="#2C5364" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <!-- Side Menu Column -->
            <ColumnDefinition Width="200" />
            <!-- Main Content Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Modern Side Menu with Buttons -->
        <Border Grid.Column="0" Background="#23272A" CornerRadius="15" Margin="10" Padding="10" Opacity="0.95">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <!-- Logo Image -->
                <Image Source="\Assets\logo.png" Width="180" Height="90" />
                <!-- Username Text -->
                <TextBlock x:Name="LoggedUser" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Text="User: [Username]" Margin="0,20,0,20" />

                <!-- Menu Buttons styled using ModernMenuButtonStyle -->
                <Button x:Name="btnHome" Content="Home" Style="{StaticResource ModernMenuButtonStyle}" Click="btnHome_Click" />
                <Button x:Name="btnPatientInfo" Content="Patient Info" Style="{StaticResource ModernMenuButtonStyle}" Click="btnPatientInfo_Click" />
                <Button x:Name="btnCaregiverInfo" Content="Caregiver Info" Style="{StaticResource ModernMenuButtonStyle}" Click="btnCaregiverInfo_Click" />
                <Button x:Name="btnMar" Content="Mar" Style="{StaticResource ModernMenuButtonStyle}" Click="btnMar_Click" />
                <Button x:Name="btnSchedule" Content="Schedule" Style="{StaticResource ModernMenuButtonStyle}" Click="btnSchedule_Click" />
                <Button x:Name="btnReport" Content="Report" Style="{StaticResource ModernMenuButtonStyle}" Click="btnReport_Click" />
                <Button x:Name="btnLogout" Content="Logout" Background="#00BFFF" Foreground="White" Style="{StaticResource ModernMenuButtonStyle}" Click="btnLogout_Click" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="10">
            <!-- Welcome Text -->
            <TextBlock Text="Welcome to Acolytes Home Health Care Patient Management System! " FontSize="17" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="#FFFFFF" Margin="0,20,0,20" HorizontalAlignment="Center" />
            <Image Source="/Assets/better.jpeg" Width="623" Height="421" Stretch="Uniform"/>
            <!-- Image -->
        </StackPanel>

        <!-- Popup for displaying button hover information -->
        <Popup x:Name="Popup" Placement="Right" IsOpen="False">
            <Border Background="#2C2F33" CornerRadius="8" Padding="10">
                <TextBlock x:Name="PopupText" Foreground="White" FontSize="14"/>
            </Border>
        </Popup>
    </Grid>
</Page>
