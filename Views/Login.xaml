<UserControl x:Class="MedicationApp.Views.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicationApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="812.5" d:DesignWidth="1631.25">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>



        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>

            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Sign In" FontSize="36" 
                       HorizontalAlignment="Center" Margin="0, 75, 0, 0"/>
            <TextBlock Grid.Row="1" Text="UserName" HorizontalAlignment="Center" Margin="-275, 40, 10, 10"/>
            <TextBox Grid.Row="1" Text="" Margin="75, 40, 0, 0" Width="250"/>
            <TextBlock Grid.Row="2" Text="Password" HorizontalAlignment="Center" Margin="-275, 10, 10, 10"/>
            <TextBox Grid.Row="2" Text="" Margin="75, 10, 0, 0" Width="250" />
            <Button Grid.Row="3" HorizontalAlignment="Center" Width="125" Height="25" Margin="0, 20, 10, 10"
                    Click="SignIn_Click" Command="{Binding SignInCommand}" CommandParameter="HomePage">Sign in
                </Button>

        </Grid>
    </Grid>
</UserControl>
