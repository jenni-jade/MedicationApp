<Window x:Class="MedicationApp.Pages.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="723" Width="750">
    <Grid Margin="0">
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F2027" Offset="0" />
                <GradientStop Color="#203A43" Offset="0.5" />
                <GradientStop Color="#2C5364" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Border for the login content -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="415" Background="#1C1C1C" Padding="20" CornerRadius="15">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="363" Margin="0,20,0,20">

                <!-- Business Name or Title -->
                <TextBlock FontFamily="pack://application:,,,/Fonts/#Raleway Thin"  
                           Foreground="#FFFFFF" Text="Acolytes Home Health Care LLC" FontSize="24" Margin="0,0,0,20" HorizontalAlignment="Center" />

                <!-- Corrected Company Logo or Image -->
                <Image x:Name="acolytes" Source="/Assets/acolytes.png" Height="100" Width="200"/>

                <!-- Sign In Title -->
                <TextBlock FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
                           Foreground="#FFFFFF" Text="Sign On" FontSize="20" FontWeight="Bold" Margin="0,20,0,20"/>

                <!-- Username Label and TextBox -->
                <TextBlock FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
                           Foreground="#00FFFF" Text="Username:" FontSize="16" Margin="0,10,0,5"/>
                <Border CornerRadius="15" Background="#2C2C2C" Margin="0,0,0,15">
                    <TextBox x:Name="userText" Foreground="White" Background="Transparent" Height="35" Width="346" Padding="8" BorderThickness="0" />
                </Border>

                <!-- Password Label and PasswordBox -->
                <TextBlock FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
                           Foreground="#00FFFF" Text="Password:" FontSize="16" Margin="0,10,0,5"/>
                <Border CornerRadius="15" Background="#2C2C2C" Margin="0,0,0,25">
                    <PasswordBox x:Name="passwordBox" Foreground="White" Background="Transparent" Height="35" Width="340" Padding="8" BorderThickness="0" />
                </Border>

                <!-- Sign In Button -->
                <Button Content="Sign In" Width="200" Height="40" Background="#00BFFF" Foreground="White" FontWeight="Bold"
                        Margin="0,0,0,10" HorizontalAlignment="Center" BorderBrush="Transparent" Click="SignIn_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="15" Padding="10" BorderBrush="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00FFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#008080"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Create User Button -->
                <Button Content="Create User" Width="200" Height="40" Background="#2C2C2C" Foreground="#00FFFF" FontWeight="Bold"
                        Margin="0,0,0,0" HorizontalAlignment="Center" BorderBrush="Transparent" Click="CreateUser_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="15" Padding="10" BorderBrush="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00BFFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#008080"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>