<Window x:Class="MedicationApp.Views.PatientViews.PatientDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Patient Details" Height="800" Width="800">
 
    <Window.Resources>
        <Style x:Key="ModernMenuButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Raleway Thin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2F33"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7289DA"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7289DA" BlurRadius="15" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Click Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4E5D94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F2027" Offset="0" />
                <GradientStop Color="#203A43" Offset="0.5" />
                <GradientStop Color="#2C5364" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <!-- Side Menu Column -->
            <ColumnDefinition Width="200" />
            <!-- Main Content Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Modern Side Menu with Buttons -->
        <Border Grid.Column="0" Background="#23272A" CornerRadius="15" Margin="10" Padding="10" Opacity="0.95">
            <StackPanel VerticalAlignment="Stretch">
                <!-- Logo Image -->
                <Image Source="\Assets\logo.png" Width="180" Height="90" />
                <!-- Username Text -->
                <TextBlock x:Name="LoggedUser" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="#00FFFF" FontSize="18" TextAlignment="Center" Margin="0,20,0,20" />

                <!-- Menu Buttons styled using ModernMenuButtonStyle -->
                <Button x:Name="btnHome" Content="Home" Style="{StaticResource ModernMenuButtonStyle}" Click="btnHome_Click"/>
                <Button x:Name="btnPatientList" Content="Patient List" Style="{StaticResource ModernMenuButtonStyle}" Click="btnPatientList_Click"/>
                <Button x:Name="btnCaregiverInfo" Content="Caregiver Info" Style="{StaticResource ModernMenuButtonStyle}" Click="btnCaregiverInfo_Click"/>
                <Button x:Name="btnMar" Content="Mar" Style="{StaticResource ModernMenuButtonStyle}" Click="btnMar_Click"/>
                <Button x:Name="btnSchedule" Content="Schedule" Style="{StaticResource ModernMenuButtonStyle}" Click="btnSchedule_Click"/>
                <Button x:Name="btnReport" Content="Report" Style="{StaticResource ModernMenuButtonStyle}" Click="btnReport_Click"/>
                <Button x:Name="btnLogout" Content="Logout" Background="#00BFFF" Foreground="White" Style="{StaticResource ModernMenuButtonStyle}" Click="btnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area with ScrollViewer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Patient Details Form" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" FontSize="25" Foreground="#FFFFFF" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <!-- Buttons at the top for navigating sections -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="Personal Information" FontFamily="Raleway" FontWeight="Thin" Foreground="White" FontSize="13" Click="ScrollToPersonalInfo"/>
                    <Button Content="Insurance Information" FontFamily="Raleway" FontWeight="Thin" Foreground="White" FontSize="13" Margin="10,0,0,0" Click="ScrollToInsuranceInfo"/>
                    <Button Content="Priorities" FontFamily="Raleway" FontWeight="Thin" Foreground="White" FontSize="13" Margin="10,0,0,0" Click="ScrollToPriorities"/>
                    <Button Content="Services" FontFamily="Raleway" FontWeight="Thin" Foreground="White" FontSize="13" Margin="10,0,0,0" Click="ScrollToServices"/>
                    <Button Content="Home Management" FontFamily="Raleway" FontWeight="Thin" Foreground="White" FontSize="13" Margin="10,0,0,0" Click="ScrollToHomeManagement"/>
                </StackPanel>

                <!-- GroupBox for Personal Information -->
                <GroupBox  x:Name="PersonalInfoGroupBox" Header="PERSONAL INFORMATION" FontFamily="pack://application:,,,/Fonts/#Raleway Bold"
    FontSize="15" Foreground="White" Margin="0,20,0,10">
                    <StackPanel>
                        <!-- Patient ID -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Patient ID: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
Foreground="White" Width="150"/>
                            <TextBox x:Name="txtPatientId" FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Patient Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Name: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin"
Foreground="White" Width="150"/>
                            <TextBox x:Name="txtName" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Patient Age -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Age: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" FontWeight="Light" Width="150"/>
                            <TextBox x:Name="txtAge" FontFamily="Raleway" Foreground="White" Width="100"/>
                        </StackPanel>

                        <!-- Patient Birthdate with DatePicker -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Date of Birth: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="150"/>
                            <DatePicker x:Name="dpBirthdate" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Patient Height -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Height: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="150"/>
                            <TextBox x:Name="txtHeight" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="100"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>



                <!-- GroupBox for Insurance Information -->
                <GroupBox x:Name="InsuranceInfoGroupBox" Header="INSURANCE INFORMATION" FontFamily="pack://application:,,,/Fonts/#Raleway Bold" FontSize="15" Foreground="White" Margin="0,20,0,10">
                    <StackPanel>
                        <!-- Primary Insurance -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Primary Insurance: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="150"/>
                            <TextBox x:Name="txtPrimaryInsurance" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- ID Number -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="ID Number: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="150"/>
                            <TextBox x:Name="txtIDNumber" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Group Number -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Group Number: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="150"/>
                            <TextBox x:Name="txtGroupNumber" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Policy Holder Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Policy Holder Name: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="173"/>
                            <TextBox x:Name="txtPolicyHolder" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>

                        <!-- Insurance Phone Number -->
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <TextBlock Text="Insurance Phone Number: " FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="218"/>
                            <TextBox x:Name="txtInsurancePhoneNumber" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Width="200"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- GroupBox for Priorities -->
                <GroupBox x:Name="PrioritiesGroupBox" Header="PRIORITIES" FontFamily="pack://application:,,,/Fonts/#Raleway Bold" FontSize="15" Foreground="White" Margin="0,20,0,10" Height="291">
                    <UniformGrid Columns="3" Margin="0,0,0,0">
                        <CheckBox x:Name="chkIsDNR" Content="DNR" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDNRArrest" Content="DNR- ARREST" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsFullCode" Content="FULL CODE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsComfortMeasOnly" Content="COMFORT MEAS ONLY" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsLivingWill" Content="LIVING WILL" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsPowerOfAttorney" Content="POWER OF ATTORNEY" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5" Checked="chkIsPowerOfAttorney_Checked"/>
                        <CheckBox x:Name="chkIsCopyOnFile" Content="COPY ON FILE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsNCFEligible" Content="NCF ELIGIBLE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsFallRisk" Content="FALL RISK" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHOH" Content="HOH" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDisoriented" Content="DISORIENTED" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDialysis" Content="DIALYSIS" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsVulnerable" Content="VULNERABLE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDisabled" Content="DISABLED" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsEscortRequired" Content="ESCORT REQ'D" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsFrail" Content="FRAIL" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsAlert" Content="ALERT" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>







                    </UniformGrid>
                </GroupBox>

                <!-- GroupBox for Services -->
                <GroupBox x:Name="ServicesGroupBox" Header="SERVICES" FontFamily="pack://application:,,,/Fonts/#Raleway Bold" FontSize="15" Foreground="White" Margin="0,20,0,10">
                    <UniformGrid Columns="3" Margin="0,0,0,0">
                        <CheckBox x:Name="chkIsSN" Content="SN" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsPT" Content="PT" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsOT" Content="OT" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsST" Content="ST" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsMSW" Content="MSW" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHHA" Content="HHA" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHMKR" Content="HMKR" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsCompanion" Content="COMPANION" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIshousekeeper" Content="HOUSEKEEPER" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsTeleReasurance" Content="TELEREASURANCE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHomefriend" Content="HOMEFRIEND" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsNutrition" Content="NUTRITION" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsIV" Content="IV" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsRespite" Content="RESPITE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsChaplin" Content="CHAPLIN" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsMusic" Content="MUSIC" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>

                    </UniformGrid>
                </GroupBox>

                <!-- GroupBox for Home Management -->
                <GroupBox x:Name="HomeManagementGroupBox" Header="HOME MANAGEMENT" FontFamily="pack://application:,,,/Fonts/#Raleway Bold" FontSize="15" Foreground="White" Margin="0,20,0,10" Height="215">
                    <UniformGrid Columns="3" Margin="0">
                        <CheckBox x:Name="chkIsAmbulation" Content="AMBULATION" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHearing" Content="HEARING" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsVision" Content="VISION" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsSpeech" Content="SPEECH" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsOriented" Content="ORIENTED" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsPleasant" Content="PLEASANT" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsPassive" Content="PASSIVE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDepressed" Content="DEPRESSED" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsAgitated" Content="AGITATED" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsHostile" Content="HOSTILE" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsParalysis" Content="Paralysis" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsCat" Content="CAT" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsDog" Content="DOG" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsSmokes" Content="SMOKES" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>
                        <CheckBox x:Name="chkIsOther" Content="OTHER" FontFamily="pack://application:,,,/Fonts/#Raleway Thin" Foreground="White" Margin="5"/>





                    </UniformGrid>
                </GroupBox>

                <!-- Submit and Reset Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="btnSubmit" Content="Submit" Style="{StaticResource ModernMenuButtonStyle}" Click="SubmitButton_Click"/>
                    <Button x:Name="btnReset" Content="Reset" Style="{StaticResource ModernMenuButtonStyle}" Click="ResetButton_Click"/>
                </StackPanel>


                <Popup x:Name="SubmitPopup" Placement="Center" StaysOpen="False">
                    <Border Background="#2C2F33" CornerRadius="8" Padding="20" BorderBrush="#7289DA" BorderThickness="1">
                        <TextBlock Text="Submission Successful!" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                    </Border>
                  </Popup>

            </StackPanel>
        </ScrollViewer>
    </Grid>
    
    
</Window>  